@using Microsoft.AspNetCore.Mvc
@using Microsoft.VisualBasic
@using System.Diagnostics
@using System.Threading.Tasks
@using ToDoList.Frontend.Clients
@using ToDoList.Frontend.Models
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IToDoItemsClient toDoItemsClient

<div class="container mt-4 mb-5">

    <h2 class="mb-3 fw-bold text-center">Seznam úkolů</h2>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-bordered mb-0">

            <thead class="table-dark text-center align-middle">
                <tr>
                    <th class="text-center">
                        ID
                        <div class="d-inline-flex ms-1">
                            <button class="btn btn-sm btn-outline-secondary me-1"
                                @onclick="() => SortBy(i => i.Id, true)">↓</button>
                            <button class="btn btn-sm btn-outline-secondary"
                                @onclick="() => SortBy(i => i.Id, false)">↑</button>
                        </div>
                    </th>
                    <th class="text-center">
                        Název
                        <div class="d-inline-flex ms-1">
                            <button class="btn btn-sm btn-outline-secondary me-1"
                                @onclick="() => SortBy(i => i.Name, true)">↓</button>
                            <button class="btn btn-sm btn-outline-secondary"
                                @onclick="() => SortBy(i => i.Name, false)">↑</button>
                        </div>
                    </th>
                    <th class="d-none d-sm-table-cell">Popis</th>
                    <th class="d-none d-md-table-cell">Kategorie</th>
                    <th class="text-center">
                        Dokončeno
                        <div class="d-inline-flex ms-1">
                            <button class="btn btn-sm btn-outline-secondary me-1"
                                @onclick="() => SortBy(i => i.IsCompleted, true)">↓</button>
                            <button class="btn btn-sm btn-outline-secondary"
                                @onclick="() => SortBy(i => i.IsCompleted, false)">↑</button>
                        </div>
                    </th>
                    <th class="text-center">Akce</th>
                </tr>
            </thead>

            <tbody>
                @if (toDoItemViews is not null)
                {
                    @foreach (var item in toDoItemViews)
                    {
                        <tr class="align-middle">

                            <!-- ID -->
                            <td class="text-center fw-semibold">@item.Id</td>

                            <!-- Name -->
                            <td>@item.Name</td>

                            <!-- Description -->
                            <td class="d-none d-sm-table-cell">@item.Description</td>

                            <!-- Category -->
                            <td class="d-none d-md-table-cell">@item.Category</td>

                            <!-- IsCompleted -->
                            <td class="text-center">
                                <span class="badge rounded-pill @(item.IsCompleted ? "bg-success" : "bg-warning")">
                                    @(item.IsCompleted ? "Dokončený" : "Nedokončený")
                                </span>
                            </td>

                            <!-- Actions -->
                            <td class="text-center">
                                <div class="d-flex justify-content-center flex-wrap">

                                    <!-- Edit -->
                                    <button class="btn btn-sm btn-outline-primary rounded p-1 me-1 mb-1"
                                        @onclick="() => EditItem(item)" title="Editovat">
                                        <i class="bi bi-pencil-square fs-5"></i>
                                    </button>

                                    <!-- Toggle -->
                                    <button class="btn btn-sm btn-outline-success rounded p-1 me-1 mb-1"
                                        title="Přepnout splněnost">
                                        <i class="bi @(item.IsCompleted ? "bi-x-circle" : "bi-check-circle") fs-5"></i>
                                    </button>

                                    <!-- Delete -->
                                    <button class="btn btn-sm btn-outline-danger rounded p-1 mb-1" title="Smazat"
                                        @onclick="() => DeleteItem(item.Id)">
                                        <i class="bi bi-trash3 fs-5"></i>
                                    </button>
                                </div>
                            </td>

                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>
</div>

@code {
    private List<ToDoItemView>? toDoItemViews;
    protected override async Task OnInitializedAsync()
    {
        toDoItemViews = await toDoItemsClient.ReadItemsAsync();
    }
    private void SortBy<T>(Func<ToDoItemView, T> selector, bool asc)
    {
        toDoItemViews = asc
        ? toDoItemViews?.OrderBy(selector).ToList()
        : toDoItemViews?.OrderByDescending(selector).ToList();
    }

    public void EditItem(ToDoItemView toDoItem)
    {
        NavigationManager.NavigateTo(uri: $"editToDoItem/{toDoItem.Id}");
    }

    public async Task DeleteItem(int id)
    {
        await toDoItemsClient.DeleteItemAsync(id);
        toDoItemViews = await toDoItemsClient.ReadItemsAsync();
    }
}