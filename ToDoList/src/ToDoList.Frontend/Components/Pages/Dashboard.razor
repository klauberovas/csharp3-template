@using Microsoft.AspNetCore.Mvc
@using Microsoft.VisualBasic
@using System.Diagnostics
@using System.Threading.Tasks
@using ToDoList.Frontend.Clients
@using ToDoList.Frontend.Models
@rendermode InteractiveServer
@inject IToDoItemsClient toDoItemsClient

<div class="container mt-4">
    <h2 class="mb-3 fw-bold text-center">Seznam úkolů</h2>

    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle rounded shadow-sm">
            <thead class="table-dark text-center">
                <tr>
                    <th>
                        ID
                        <button class="btn btn-sm btn-outline-light ms-1"
                            @onclick="() => SortBy(i => i.Id, true)">↓</button>
                        <button class="btn btn-sm btn-outline-light ms-1"
                            @onclick="() => SortBy(i => i.Id, false)">↑</button>
                    </th>
                    <th>
                        Název
                        <button class="btn btn-sm btn-outline-light ms-1"
                            @onclick="() => SortBy(i => i.Name, true)">↓</button>
                        <button class="btn btn-sm btn-outline-light ms-1"
                            @onclick="() => SortBy(i => i.Name, false)">↑</button>
                    </th>
                    <th>Popis</th>
                    <th>
                        Dokončeno
                        <button class="btn btn-sm btn-outline-light ms-1"
                            @onclick="() => SortBy(i => i.IsCompleted, true)">↓</button>
                        <button class="btn btn-sm btn-outline-light ms-1"
                            @onclick="() => SortBy(i => i.IsCompleted, false)">↑</button>
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (toDoItemViews is not null)
                {
                    @foreach (var item in toDoItemViews)
                    {
                        <tr>
                            <td class="text-center">@item.Id</td>
                            <td>@item.Name</td>
                            <td>@item.Description</td>
                            <td class="text-center"><span
                                    class="badge @(item.IsCompleted ? "bg-success" : "bg-warning")">@(item.IsCompleted ?
                                                                "Dokončený" : "Nedokončený")</span></td>
                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>
</div>
@code {
    private List<ToDoItemView>? toDoItemViews;
    protected override async Task OnInitializedAsync()
    {
        toDoItemViews = await toDoItemsClient.ReadItemsAsync();
    }
    private void SortBy<T>(Func<ToDoItemView, T> selector, bool asc)
    {
        toDoItemViews = asc
        ? toDoItemViews?.OrderBy(selector).ToList()
        : toDoItemViews?.OrderByDescending(selector).ToList();
    }

}